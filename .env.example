# =============================================================================
# HealthMap Regional - variaveis de ambiente (EXEMPLO)
# Copie para .env na raiz do repositorio:  cp .env.example .env
# O arquivo .env NUNCA deve ser versionado. Nao use estes valores em producao.
# =============================================================================

# --- PostgreSQL (container Docker) -------------------------------------------
POSTGRES_USER=healthmap
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_DB=healthmap
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Prisma ------------------------------------------------------------------
# Deve refletir as variaveis acima. Prisma le esta URL a partir da raiz do repo.
DATABASE_URL="postgresql://healthmap:troque_esta_senha_local@localhost:5432/healthmap?schema=public"

# --- Adminer (apenas desenvolvimento) ----------------------------------------
ADMINER_PORT=8080

# --- API (apps/api) ----------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Frontend (apps/web) -----------------------------------------------------
# Variaveis NEXT_PUBLIC_* sao expostas ao navegador: nunca coloque segredo aqui.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_ENV=development

# --- ETL (Fase 5.4) -----------------------------------------------------------
# Diretorio de arquivos brutos grandes demais para versionar (ex.: IPVS/SEADE,
# etl/ingest_vulnerabilidade.py) - baixados sob demanda, nunca commitados
# (data/bronze/ esta no .gitignore).
HEALTHMAP_BRONZE_DIR=./data/bronze

# --- Reservado para fases futuras (nao utilizado na Fase 0) ------------------
# Fase 6 - autenticacao e RBAC
# AUTH_SECRET=
# Fase 7 - Oracle Cloud Infrastructure
# OCI_REGION=

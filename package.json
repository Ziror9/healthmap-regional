{
  "name": "healthmap-regional",
  "version": "0.0.0",
  "private": true,
  "description": "HealthMap Regional - Inteligencia analitica para saude publica regional",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:logs": "docker compose logs -f postgres",
    "db:check": "npm run check --workspace @healthmap/db",
    "db:seed": "npm run seed --workspace @healthmap/db",
    "db:calculate-risk": "npm run calculate-risk --workspace @healthmap/db",
    "db:calculate-indicadores-real": "npm run calculate-indicadores-real --workspace @healthmap/db",
    "db:calculate-indicadores-mortalidade-real": "npm run calculate-indicadores-mortalidade-real --workspace @healthmap/db",
    "db:calculate-risk-real": "npm run calculate-risk-real --workspace @healthmap/db",
    "db:calculate-risk-regional": "npm run calculate-risk-regional --workspace @healthmap/db",
    "prisma:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "dev:api": "npm run dev --workspace @healthmap/api",
    "dev:web": "npm run dev --workspace @healthmap/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "prisma": "^6.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}

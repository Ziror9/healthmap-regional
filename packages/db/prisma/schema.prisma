// =============================================================================
// HealthMap Regional - Prisma schema
// =============================================================================
// FASE 1 (banco + DEMO): modelo de dominio completo, conforme
// docs/data-model.md, docs/risk-methodology.md e o spike tecnico validado
// nesta mesma sessao (multiSchema funciona nativamente no Prisma 6.19 - a
// preview feature esta deprecated e nao precisa mais ser declarada).
//
// Escopo desta fase: schema, migrations e seed DEMO. NADA de calculo do
// Radar (Fase 2), agregacao/API (Fase 3), autenticacao/RBAC funcional
// (Fase 6) ou ingestao real (Fase 5). As tabelas de risco e RBAC existem
// aqui apenas como estrutura, inertes.
//
// Taxonomias provisorias (decisao explicita, documentada em
// docs/known-limitations.md, a revisar quando a ingestao REAL existir):
//   - FaixaEtaria: decenal (FX_00_09 ... FX_80_MAIS). Nao ha confirmacao de
//     que o SIH/IBGE usam exatamente esse corte - pode ser revisado na
//     Fase 5.
//   - TipoLeito: CLINICO/CIRURGICO/UTI/OUTRO. Taxonomia simplificada, nao
//     validada contra o dicionario de dados real do CNES.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["silver", "gold", "meta"]
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------
// Origem e Natureza replicam os mesmos valores de @healthmap/contracts
// (packages/contracts/src/enums.ts). Cada lado (TS/SQL) precisa da propria
// definicao de tipo - isso nao e a duplicacao de DADO que o projeto evita,
// e duplicacao de CONTRATO DE TIPO entre duas linguagens.

/// De onde vieram os insumos do dado (ADR-001 #11). Usado em todo fato gold.
enum Origem {
  REAL
  DEMO

  @@schema("gold")
}

/// Como o numero foi produzido. So existe onde pode variar por linha:
/// RiskComponenteValor e RiskScore. Nos fatos brutos (FatoInternacaoResidencia,
/// FatoInternacaoLocal, FatoCapacidadeLeitos, Populacao) a natureza e sempre
/// OBSERVADO por construcao e nao e persistida (decisao de projeto explicita
/// desta fase). IndicadorMunicipal usa a natureza fixa de IndicadorDefinicao.
enum Natureza {
  OBSERVADO
  ESTIMATIVA
  PROJECAO

  @@schema("meta")
}

/// Eixo territorial de um IndicadorDefinicao (residencia x internacao).
enum EixoTerritorial {
  RESIDENCIA
  INTERNACAO

  @@schema("meta")
}

/// Componentes previstos do Radar de Risco (docs/risk-methodology.md #2).
/// Espelha packages/risk/src/index.ts (COMPONENTES_PREVISTOS).
enum ComponenteRisco {
  PRESSAO_HOSPITALAR_ESTIMADA
  TENDENCIA
  SEVERIDADE
  VULNERABILIDADE

  @@schema("meta")
}

enum Sexo {
  MASCULINO
  FEMININO
  IGNORADO

  @@schema("gold")
}

/// Taxonomia decenal - PROVISORIA. Ver cabecalho do arquivo.
enum FaixaEtaria {
  FX_00_09
  FX_10_19
  FX_20_29
  FX_30_39
  FX_40_49
  FX_50_59
  FX_60_69
  FX_70_79
  FX_80_MAIS

  @@schema("gold")
}

/// Taxonomia simplificada - PROVISORIA. Ver cabecalho do arquivo.
enum TipoLeito {
  CLINICO
  CIRURGICO
  UTI
  OUTRO

  @@schema("gold")
}

enum ClassificacaoRisco {
  CRITICO
  ALTO
  MEDIO
  BAIXO
  MUITO_BAIXO

  @@schema("gold")
}

enum Confiabilidade {
  ALTA
  MEDIA
  BAIXA

  @@schema("gold")
}

enum IndicadorDirecao {
  MAIOR_PIOR
  MENOR_PIOR

  @@schema("meta")
}

enum ExecucaoStatus {
  INICIADA
  SUCESSO
  FALHA
  PARCIAL

  @@schema("meta")
}

enum SeveridadeCheck {
  BLOQUEANTE
  ALERTA

  @@schema("meta")
}

/// Minimo para satisfazer "entidades de RBAC criadas e inertes" do roadmap.
/// Desenho completo de RBAC e decisao de Fase 6.
enum Perfil {
  ADMIN
  GESTOR
  LEITOR

  @@schema("meta")
}

enum NivelEscopo {
  ESTADUAL
  REGIONAL
  MUNICIPAL

  @@schema("meta")
}

// -----------------------------------------------------------------------------
// silver - dimensoes
// -----------------------------------------------------------------------------

model RegiaoSaude {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  nome      String
  uf        String   @default("SP") @db.Char(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  municipios          Municipio[]
  escoposTerritoriais EscopoTerritorial[]

  fatosInternacaoResidenciaRegional FatoInternacaoResidenciaRegional[]
  fatosInternacaoLocalRegional      FatoInternacaoLocalRegional[]
  fatosCapacidadeLeitosRegional     FatoCapacidadeLeitosRegional[]
  riskComponenteValoresRegional     RiskComponenteValorRegional[]
  riskScoresRegional                RiskScoreRegional[]

  @@schema("silver")
}

model Municipio {
  id            Int      @id @default(autoincrement())
  /// Chave canonica do dominio.
  codigoIbge7   String   @unique @db.Char(7)
  /// Guardado apenas para juncao com o SIH - nunca usado como identidade em outra tabela.
  codigoIbge6   String   @unique @db.Char(6)
  nome          String
  uf            String   @db.Char(2)
  regiaoSaudeId Int
  regiaoSaude   RegiaoSaude @relation(fields: [regiaoSaudeId], references: [id])
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  estabelecimentos          Estabelecimento[]
  fatosInternacaoResidencia FatoInternacaoResidencia[]
  fatosObitoResidencia      FatoObitoResidencia[]
  fatosInternacaoLocal      FatoInternacaoLocal[]
  fatosInternacaoResidenciaAnual FatoInternacaoResidenciaAnual[]
  fluxosComoOrigem          FatoFluxoInternacao[] @relation("FluxoOrigem")
  fluxosComoDestino         FatoFluxoInternacao[] @relation("FluxoDestino")
  fatosCapacidadeLeitos     FatoCapacidadeLeitos[]
  populacoes                Populacao[]
  populacoesEstimadas       PopulacaoEstimada[]
  indicadoresMunicipais     IndicadorMunicipal[]
  riskComponenteValores     RiskComponenteValor[]
  riskScores                RiskScore[]
  escoposTerritoriais       EscopoTerritorial[]

  @@index([regiaoSaudeId])
  @@schema("silver")
}

model Competencia {
  id        Int      @id @default(autoincrement())
  ano       Int
  mes       Int
  /// Primeiro dia do mes.
  dataRef   DateTime @db.Date
  /// Insumo direto de leitos-dia.
  diasNoMes Int

  fatosInternacaoResidencia FatoInternacaoResidencia[]
  fatosInternacaoLocal      FatoInternacaoLocal[]
  fatosCapacidadeLeitos     FatoCapacidadeLeitos[]
  riskComponenteValores     RiskComponenteValor[]
  riskScores                RiskScore[]
  ingestaoExecucoes         IngestaoExecucao[]

  fatosInternacaoResidenciaRegional FatoInternacaoResidenciaRegional[]
  fatosInternacaoLocalRegional      FatoInternacaoLocalRegional[]
  fatosCapacidadeLeitosRegional     FatoCapacidadeLeitosRegional[]
  riskComponenteValoresRegional     RiskComponenteValorRegional[]
  riskScoresRegional                RiskScoreRegional[]

  @@unique([ano, mes])
  @@unique([dataRef])
  @@schema("silver")
}

model GrupoCid {
  id              Int      @id @default(autoincrement())
  codigoCidInicio String
  codigoCidFim    String
  nome            String
  /// Permite corte por topografia (mama, prostata...) no futuro sem migracao
  /// estrutural das tabelas de fato. No MVP: 1 unica linha, C00-C97.
  agrupamento     String
  capitulo        String
  ativo           Boolean  @default(true)

  fatosInternacaoResidencia FatoInternacaoResidencia[]
  fatosObitoResidencia      FatoObitoResidencia[]
  fatosInternacaoLocal      FatoInternacaoLocal[]
  fatosFluxoInternacao      FatoFluxoInternacao[]
  fatosInternacaoResidenciaAnual    FatoInternacaoResidenciaAnual[]
  fatosInternacaoResidenciaRegional FatoInternacaoResidenciaRegional[]
  fatosInternacaoLocalRegional      FatoInternacaoLocalRegional[]

  @@unique([codigoCidInicio, codigoCidFim, agrupamento])
  @@schema("silver")
}

model Estabelecimento {
  id                    Int      @id @default(autoincrement())
  codigoCnes            String   @unique
  nome                  String
  /// Sempre o municipio de INTERNACAO - um estabelecimento e um lugar fisico,
  /// nao ha ambiguidade residencia/internacao aqui.
  municipioId           Int
  municipio             Municipio @relation(fields: [municipioId], references: [id])
  tipo                  String
  habilitacaoOncologica Boolean
  ativo                 Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([municipioId])
  @@schema("silver")
}

// -----------------------------------------------------------------------------
// gold - fatos e camada de risco materializada
// -----------------------------------------------------------------------------

model FatoInternacaoResidencia {
  id Int @id @default(autoincrement())

  /// Eixo RESIDENCIA - onde vivem as pessoas que adoeceram.
  municipioResidenciaId Int
  municipioResidencia   Municipio @relation(fields: [municipioResidenciaId], references: [id])
  competenciaId         Int
  competencia           Competencia @relation(fields: [competenciaId], references: [id])
  grupoCidId            Int
  grupoCid              GrupoCid @relation(fields: [grupoCidId], references: [id])
  faixaEtaria           FaixaEtaria
  sexo                  Sexo

  /// NULL quando suprimido = true. Ver docs/known-limitations.md (supressao).
  internacoes     Int?
  obitos          Int?
  diasPermanencia Int?
  suprimido       Boolean @default(false)

  origem     Origem
  execucaoId String
  execucao   IngestaoExecucao @relation(fields: [execucaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([municipioResidenciaId, competenciaId, grupoCidId, faixaEtaria, sexo])
  @@index([competenciaId])
  @@index([origem])
  @@index([execucaoId])
  @@schema("gold")
}

/// Mortalidade (SIM/DATASUS, Fase 5.6) - eixo RESIDENCIA por natureza (Declaracao
/// de Obito registra o municipio onde a pessoa vivia, nao um "eixo internacao"
/// equivalente ao de FatoInternacaoLocal - obito nao tem local de atendimento
/// analogo). Por isso so tem o par municipioResidencia, nunca um "FatoObitoLocal".
///
/// GRAO ANUAL (municipio x ano x grupoCid), NAO mensal/faixaEtaria/sexo como
/// FatoInternacaoResidencia - decisao tomada ao implementar (nao na
/// especificacao original), depois de confirmar que o grao fino faz TODOS os
/// municipios ficarem suprimidos: um municipio com ~70 obitos/ano, quebrado em
/// 12 meses x 9 faixas x 2-3 sexos (ate ~216 celulas), quase sempre tem
/// alguma celula fina com 1-4 obitos, e bool_or sobre essas celulas nulifica
/// o total anual do municipio inteiro (0 de 645 municipios sobreviviam). A
/// supressao n<5 aqui e decidida UMA VEZ sobre o total anual por municipio,
/// mesmo metodo ja validado (spike desta fase: 87,6% de cobertura) - nao e
/// uma soma parcial de celulas ja suprimidas (essas nunca existiram: a
/// agregacao de origem, em etl/ingest_sim.py, soma os registros individuais
/// direto, antes de qualquer supressao).
///
/// Indicador derivado (TAXA_MORTALIDADE_ONCOLOGICA_10K_HAB) e OBSERVADO e
/// NUNCA entra no RiskScore - decisao registrada em docs/fase-5.6-relatorio.md.
model FatoObitoResidencia {
  id Int @id @default(autoincrement())

  municipioResidenciaId Int
  municipioResidencia   Municipio @relation(fields: [municipioResidenciaId], references: [id])
  ano                   Int
  grupoCidId            Int
  grupoCid              GrupoCid @relation(fields: [grupoCidId], references: [id])

  /// NULL quando suprimido = true (n<5, decidido sobre o total anual) - nunca 0.
  obitos    Int?
  suprimido Boolean @default(false)

  origem     Origem
  execucaoId String
  execucao   IngestaoExecucao @relation(fields: [execucaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([municipioResidenciaId, ano, grupoCidId])
  @@index([ano])
  @@index([origem])
  @@index([execucaoId])
  @@schema("gold")
}

model FatoInternacaoLocal {
  id Int @id @default(autoincrement())

  /// Eixo INTERNACAO - onde o sistema hospitalar absorveu a demanda.
  municipioInternacaoId Int
  municipioInternacao   Municipio @relation(fields: [municipioInternacaoId], references: [id])
  competenciaId         Int
  competencia           Competencia @relation(fields: [competenciaId], references: [id])
  grupoCidId            Int
  grupoCid              GrupoCid @relation(fields: [grupoCidId], references: [id])
  faixaEtaria           FaixaEtaria
  sexo                  Sexo

  /// NULL quando suprimido = true.
  internacoes  Int?
  pacientesDia Int?
  diariasUti   Int?
  obitos       Int?
  suprimido    Boolean @default(false)

  origem     Origem
  execucaoId String
  execucao   IngestaoExecucao @relation(fields: [execucaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([municipioInternacaoId, competenciaId, grupoCidId, faixaEtaria, sexo])
  @@index([competenciaId])
  @@index([origem])
  @@index([execucaoId])
  @@schema("gold")
}

/// Internacoes por municipio de RESIDENCIA no ANO (Fase 5.10).
///
/// POR QUE UMA TABELA NOVA, e nao uma agregacao de FatoInternacaoResidencia:
/// aquela tabela tem grao municipio x competencia x grupoCid x faixaEtaria x
/// sexo, e a supressao n<5 e aplicada NAQUELE grao, na ingestao. 81,5% das
/// celulas (34.868 de 42.778) ficam suprimidas, e o valor delas e APAGADO -
/// somar o que sobrou daria 126.282 de 195.119 internacoes, subestimando o
/// total sem avisar. Reconstruir as celulas apagadas seria imputacao.
/// Por isso o total anual e agregado do dado BRUTO (etl/ingest_sih.py), antes
/// de qualquer supressao, e a regra n<5 e decidida UMA vez sobre o total do
/// ano - mesma solucao ja adotada para FatoObitoResidencia na Fase 5.6.
///
/// NAO substitui FatoInternacaoResidencia (que continua servindo o recorte
/// demografico) nem FatoFluxoInternacao (par origem->destino, Fase 5.8):
/// sao produtos analiticos diferentes sobre a mesma fonte.
model FatoInternacaoResidenciaAnual {
  id Int @id @default(autoincrement())

  municipioResidenciaId Int
  municipioResidencia   Municipio @relation(fields: [municipioResidenciaId], references: [id])
  ano                   Int
  grupoCidId            Int
  grupoCid              GrupoCid @relation(fields: [grupoCidId], references: [id])

  /// NULL quando suprimido = true. NUNCA 0.
  internacoes Int?
  suprimido   Boolean @default(false)

  origem     Origem
  execucaoId String
  execucao   IngestaoExecucao @relation(fields: [execucaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([municipioResidenciaId, ano, grupoCidId])
  @@index([ano])
  @@index([origem])
  @@schema("gold")
}

/// Fluxo assistencial: quantas internacoes de residentes do municipio A
/// aconteceram no municipio B (Fase 5.8).
///
/// NUANCE ARQUITETURAL DELIBERADA: e a unica tabela do projeto que carrega os
/// dois eixos (residencia e internacao) na MESMA linha. O invariante #4 do
/// CLAUDE.md ("residencia e internacao nunca se misturam") existe para impedir
/// que um NUMERO seja composto misturando os eixos (ex.: taxa por 10 mil
/// habitantes usando internacoes por local de atendimento). Aqui os dois eixos
/// permanecem explicitos, rotulados e nunca somados entre si - o par ordenado
/// (origem, destino) E o dado. Sem essa tabela o fluxo e irrecuperavel: as
/// agregacoes marginais existentes (FatoInternacaoResidencia/Local) perdem o
/// pareamento no momento do groupby, e reconstrui-lo por estimativa seria
/// inventar dado. Ver docs/fase-5.8-relatorio.md.
///
/// Grao ANUAL (nao competencia): um par origem->destino num unico mes quase
/// sempre tem menos de 5 pacientes, e a supressao n<5 no grao fino apagaria
/// quase todo o fluxo - mesma licao do pivo de grao da Fase 5.6
/// (FatoObitoResidencia). A supressao e decidida UMA vez, sobre o total anual
/// do par.
model FatoFluxoInternacao {
  id Int @id @default(autoincrement())

  /// Onde o paciente mora (eixo RESIDENCIA).
  municipioResidenciaId Int
  municipioResidencia   Municipio @relation("FluxoOrigem", fields: [municipioResidenciaId], references: [id])
  /// Onde a internacao aconteceu (eixo INTERNACAO).
  municipioInternacaoId Int
  municipioInternacao   Municipio @relation("FluxoDestino", fields: [municipioInternacaoId], references: [id])
  ano                   Int
  grupoCidId            Int
  grupoCid              GrupoCid @relation(fields: [grupoCidId], references: [id])

  /// NULL quando suprimido = true. NUNCA 0.
  internacoes Int?
  suprimido   Boolean @default(false)

  origem     Origem
  execucaoId String
  execucao   IngestaoExecucao @relation(fields: [execucaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([municipioResidenciaId, municipioInternacaoId, ano, grupoCidId])
  @@index([ano])
  @@index([municipioResidenciaId])
  @@index([municipioInternacaoId])
  @@index([origem])
  @@schema("gold")
}

model FatoCapacidadeLeitos {
  id Int @id @default(autoincrement())

  /// Sempre municipio de INTERNACAO.
  municipioInternacaoId Int
  municipioInternacao   Municipio @relation(fields: [municipioInternacaoId], references: [id])
  competenciaId         Int
  competencia           Competencia @relation(fields: [competenciaId], references: [id])
  tipoLeito              TipoLeito

  /// Autodeclarado (CNES). leitosDia = leitosSus * competencia.diasNoMes e
  /// deliberadamente NAO persistido - calculado em packages/db na leitura,
  /// para nao duplicar um valor 100% derivavel de outras colunas.
  leitosSus    Int
  leitosTotais Int

  origem     Origem
  execucaoId String
  execucao   IngestaoExecucao @relation(fields: [execucaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([municipioInternacaoId, competenciaId, tipoLeito])
  @@index([competenciaId])
  @@schema("gold")
}

model Populacao {
  id Int @id @default(autoincrement())

  municipioId Int
  municipio   Municipio @relation(fields: [municipioId], references: [id])
  ano         Int
  faixaEtaria FaixaEtaria
  sexo        Sexo
  populacao   Int

  origem     Origem
  execucaoId String
  execucao   IngestaoExecucao @relation(fields: [execucaoId], references: [id])

  createdAt DateTime @default(now())

  @@unique([municipioId, ano, faixaEtaria, sexo])
  @@schema("gold")
}

/// Populacao TOTAL estimada anual (IBGE, tabela SIDRA 6579 - "Estimativas de
/// populacao"), complementar a Populacao (grao censitario municipio x ano x
/// faixaEtaria x sexo, so existe em ano de Censo). A estimativa anual so
/// publica o total por municipio, sem quebra por idade/sexo - por isso NUNCA
/// deve alimentar Populacao (faixaEtaria/sexo la sao NOT NULL: forcar um
/// valor ali exigiria inventar uma distribuicao que a fonte nao da).
/// Usada como denominador de indicadores anuais (ex. TAXA_INTERNACAO_10K_HAB)
/// para anos nao-censitarios - ver etl/ingest_populacao.py.
model PopulacaoEstimada {
  id Int @id @default(autoincrement())

  municipioId    Int
  municipio      Municipio @relation(fields: [municipioId], references: [id])
  ano            Int
  populacaoTotal Int

  origem     Origem
  execucaoId String
  execucao   IngestaoExecucao @relation(fields: [execucaoId], references: [id])

  createdAt DateTime @default(now())

  @@unique([municipioId, ano])
  @@schema("gold")
}

model IndicadorMunicipal {
  id Int @id @default(autoincrement())

  municipioId          Int
  municipio            Municipio @relation(fields: [municipioId], references: [id])
  ano                  Int
  indicadorDefinicaoId String
  /// Natureza deste indicador vem de IndicadorDefinicao.naturezaPadrao -
  /// nao e repetida aqui (evita duplicacao que poderia divergir do valor
  /// fixado na definicao).
  indicadorDefinicao   IndicadorDefinicao @relation(fields: [indicadorDefinicaoId], references: [chave])

  valor       Decimal  @db.Decimal(14, 4)
  denominador Decimal? @db.Decimal(14, 4)

  origem     Origem
  execucaoId String
  execucao   IngestaoExecucao @relation(fields: [execucaoId], references: [id])

  createdAt DateTime @default(now())

  @@unique([municipioId, ano, indicadorDefinicaoId])
  @@schema("gold")
}

/// Materializado pelo motor da Fase 2 (packages/risk). Nesta fase existe
/// apenas como estrutura - nenhuma linha calculada. Append-only: recalculo
/// com riskConfigId novo insere, nunca sobrescreve.
model RiskComponenteValor {
  id Int @id @default(autoincrement())

  municipioId   Int
  municipio     Municipio @relation(fields: [municipioId], references: [id])
  competenciaId Int
  competencia   Competencia @relation(fields: [competenciaId], references: [id])
  riskConfigId  Int
  riskConfig    RiskConfig @relation(fields: [riskConfigId], references: [id])
  componente    ComponenteRisco

  valorBruto       Decimal? @db.Decimal(14, 4)
  valorNormalizado Decimal? @db.Decimal(5, 4)
  /// Aqui SIM e persistida por linha: pode variar mesmo dentro do mesmo
  /// componente (ex.: VULNERABILIDADE indisponivel hoje, definida amanha).
  natureza         Natureza
  confiabilidade   Confiabilidade
  disponivel       Boolean @default(true)
  origem           Origem

  createdAt DateTime @default(now())

  @@unique([municipioId, competenciaId, riskConfigId, componente])
  @@schema("gold")
}

/// Materializado pela Fase 2. Estrutura apenas - nenhuma linha calculada
/// ainda. Append-only pelo mesmo motivo de RiskComponenteValor.
model RiskScore {
  id Int @id @default(autoincrement())

  municipioId   Int
  municipio     Municipio @relation(fields: [municipioId], references: [id])
  competenciaId Int
  competencia   Competencia @relation(fields: [competenciaId], references: [id])
  riskConfigId  Int
  riskConfig    RiskConfig @relation(fields: [riskConfigId], references: [id])

  indice         Decimal @db.Decimal(5, 4)
  classificacao  ClassificacaoRisco
  confiabilidade Confiabilidade
  natureza       Natureza
  origem         Origem

  createdAt DateTime @default(now())

  @@unique([municipioId, competenciaId, riskConfigId])
  @@schema("gold")
}

// -----------------------------------------------------------------------------
// gold - grao REGIONAL (Fase 5.5) - mesma familia de fatos acima, mas por
// RegiaoSaude (DRS) em vez de Municipio. Tabelas PARALELAS, nao uma soma dos
// fatos municipais: agregar municipios ja suprimidos perderia a informacao
// suprimida para sempre (nunca foi persistida - ver etl/README.md #1), entao
// nao ha como "somar depois". A supressao n<5 e decidida de novo, de forma
// independente, direto do dado bruto, no grao regional - por isso os
// ingest_*.py (SIH, CNES) escrevem aqui a partir do MESMO dataframe bruto que
// alimenta o grao municipal, nunca lendo de FatoInternacaoResidencia/Local/
// FatoCapacidadeLeitos. Ver docs/fase-5.5-relatorio.md.
// -----------------------------------------------------------------------------

model FatoInternacaoResidenciaRegional {
  id Int @id @default(autoincrement())

  regiaoSaudeResidenciaId Int
  regiaoSaudeResidencia   RegiaoSaude @relation(fields: [regiaoSaudeResidenciaId], references: [id])
  competenciaId           Int
  competencia             Competencia @relation(fields: [competenciaId], references: [id])
  grupoCidId              Int
  grupoCid                GrupoCid @relation(fields: [grupoCidId], references: [id])
  faixaEtaria             FaixaEtaria
  sexo                    Sexo

  internacoes     Int?
  obitos          Int?
  diasPermanencia Int?
  suprimido       Boolean @default(false)

  origem     Origem
  execucaoId String
  execucao   IngestaoExecucao @relation(fields: [execucaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([regiaoSaudeResidenciaId, competenciaId, grupoCidId, faixaEtaria, sexo])
  @@index([competenciaId])
  @@schema("gold")
}

model FatoInternacaoLocalRegional {
  id Int @id @default(autoincrement())

  regiaoSaudeInternacaoId Int
  regiaoSaudeInternacao   RegiaoSaude @relation(fields: [regiaoSaudeInternacaoId], references: [id])
  competenciaId           Int
  competencia             Competencia @relation(fields: [competenciaId], references: [id])
  grupoCidId              Int
  grupoCid                GrupoCid @relation(fields: [grupoCidId], references: [id])
  faixaEtaria             FaixaEtaria
  sexo                    Sexo

  internacoes  Int?
  pacientesDia Int?
  diariasUti   Int?
  obitos       Int?
  suprimido    Boolean @default(false)

  origem     Origem
  execucaoId String
  execucao   IngestaoExecucao @relation(fields: [execucaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([regiaoSaudeInternacaoId, competenciaId, grupoCidId, faixaEtaria, sexo])
  @@index([competenciaId])
  @@schema("gold")
}

model FatoCapacidadeLeitosRegional {
  id Int @id @default(autoincrement())

  regiaoSaudeInternacaoId Int
  regiaoSaudeInternacao   RegiaoSaude @relation(fields: [regiaoSaudeInternacaoId], references: [id])
  competenciaId           Int
  competencia             Competencia @relation(fields: [competenciaId], references: [id])
  tipoLeito               TipoLeito

  /// Sem supressao (capacidade operacional, nao contagem de pacientes -
  /// mesma decisao ja tomada para FatoCapacidadeLeitos municipal).
  leitosSus    Int
  leitosTotais Int

  origem     Origem
  execucaoId String
  execucao   IngestaoExecucao @relation(fields: [execucaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([regiaoSaudeInternacaoId, competenciaId, tipoLeito])
  @@index([competenciaId])
  @@schema("gold")
}

model RiskComponenteValorRegional {
  id Int @id @default(autoincrement())

  regiaoSaudeId Int
  regiaoSaude   RegiaoSaude @relation(fields: [regiaoSaudeId], references: [id])
  competenciaId Int
  competencia   Competencia @relation(fields: [competenciaId], references: [id])
  riskConfigId  Int
  riskConfig    RiskConfig @relation(fields: [riskConfigId], references: [id])
  componente    ComponenteRisco

  valorBruto       Decimal? @db.Decimal(14, 4)
  valorNormalizado Decimal? @db.Decimal(5, 4)
  natureza         Natureza
  confiabilidade   Confiabilidade
  disponivel       Boolean @default(true)
  origem           Origem

  createdAt DateTime @default(now())

  @@unique([regiaoSaudeId, competenciaId, riskConfigId, componente])
  @@schema("gold")
}

model RiskScoreRegional {
  id Int @id @default(autoincrement())

  regiaoSaudeId Int
  regiaoSaude   RegiaoSaude @relation(fields: [regiaoSaudeId], references: [id])
  competenciaId Int
  competencia   Competencia @relation(fields: [competenciaId], references: [id])
  riskConfigId  Int
  riskConfig    RiskConfig @relation(fields: [riskConfigId], references: [id])

  indice         Decimal @db.Decimal(5, 4)
  classificacao  ClassificacaoRisco
  confiabilidade Confiabilidade
  natureza       Natureza
  origem         Origem

  createdAt DateTime @default(now())

  @@unique([regiaoSaudeId, competenciaId, riskConfigId])
  @@schema("gold")
}

// -----------------------------------------------------------------------------
// meta - configuracao versionada da metodologia e governanca
// -----------------------------------------------------------------------------

model IndicadorDefinicao {
  /// Chave legivel e estavel (ex. 'PRESSAO_HOSPITALAR_ESTIMADA') - referenciada
  /// por packages/risk e pelos seeds. Tabela pequena e curada, PK natural
  /// compensa (diferente das dimensoes de alto volume, que usam Int surrogate).
  chave            String  @id
  nome             String
  fonte            String
  unidade          String
  periodicidade    String
  direcao          IndicadorDirecao
  eixoTerritorial  EixoTerritorial
  naturezaPadrao   Natureza
  notaMetodologica String?
  ativo            Boolean @default(true)

  indicadoresMunicipais IndicadorMunicipal[]
  riskConfigComponentes RiskConfigComponente[]

  @@schema("meta")
}

/// Versao da metodologia do Radar. "id" e o proprio numero de versao exibido
/// (nao existe campo "versao" separado - seria duplicar o id). Linhas nunca
/// sao atualizadas apos uso em calculo: nova config = nova linha.
model RiskConfig {
  id                 Int       @id @default(autoincrement())
  metodoNormalizacao String
  limiarVolumeMinimo Int
  vigenciaInicio     DateTime
  vigenciaFim        DateTime?
  /// Nenhum peso e oficial ate ser calibrado e validado (risk-methodology.md #6).
  /// Default false em toda linha nova. No maximo 1 linha com oficial=true -
  /// garantido por indice unico parcial adicionado manualmente na migration
  /// (Prisma DSL nao expressa indice parcial).
  oficial            Boolean   @default(false)
  autor              String
  notaVersao         String?
  createdAt          DateTime  @default(now())

  componentes            RiskConfigComponente[]
  riskComponenteValores  RiskComponenteValor[]
  riskScores             RiskScore[]
  riskComponenteValoresRegional RiskComponenteValorRegional[]
  riskScoresRegional            RiskScoreRegional[]

  @@schema("meta")
}

model RiskConfigComponente {
  id                   Int      @id @default(autoincrement())
  riskConfigId         Int
  riskConfig           RiskConfig @relation(fields: [riskConfigId], references: [id])
  componente           ComponenteRisco
  /// 0-1. CHECK adicionado manualmente na migration.
  peso                 Decimal  @db.Decimal(5, 4)
  /// Nullable: permite o componente VULNERABILIDADE existir sem fonte
  /// definida (risk-methodology.md #2.4).
  indicadorDefinicaoId String?
  indicadorDefinicao   IndicadorDefinicao? @relation(fields: [indicadorDefinicaoId], references: [chave])
  parametros           Json?
  ativo                Boolean  @default(true)

  @@unique([riskConfigId, componente])
  @@schema("meta")
}

model FonteDados {
  /// Chave legivel (ex. 'SIH_SUS', 'CNES', 'IBGE', 'GERADOR_DEMO').
  chave                 String  @id
  nome                  String
  url                   String?
  licenca                String?
  periodicidade          String
  defasagemEsperadaDias  Int?
  ativo                  Boolean @default(true)

  execucoes IngestaoExecucao[]

  @@schema("meta")
}

/// Alvo de execucaoId de todo fato gold - garante que "nenhuma linha de
/// fato" fica sem linhagem, REAL ou DEMO. DEMO e modelado como so mais uma
/// fonte (fonteDadosId = 'GERADOR_DEMO'), nao como mecanismo paralelo.
model IngestaoExecucao {
  id                String   @id @default(cuid())
  fonteDadosId      String
  fonteDados        FonteDados @relation(fields: [fonteDadosId], references: [chave])
  /// Nullable: cargas de referencia (ex. municipios) nao sao por competencia.
  competenciaId     Int?
  competencia       Competencia? @relation(fields: [competenciaId], references: [id])
  status            ExecucaoStatus
  hashInsumos       String?
  versaoPipeline    String
  linhasProcessadas Int?
  linhasRejeitadas  Int?
  iniciadoEm        DateTime
  finalizadoEm      DateTime?
  mensagemErro      String?
  createdAt         DateTime @default(now())

  fatosInternacaoResidencia FatoInternacaoResidencia[]
  fatosObitoResidencia      FatoObitoResidencia[]
  fatosInternacaoLocal      FatoInternacaoLocal[]
  fatosFluxoInternacao      FatoFluxoInternacao[]
  fatosInternacaoResidenciaAnual FatoInternacaoResidenciaAnual[]
  fatosCapacidadeLeitos     FatoCapacidadeLeitos[]
  populacoes                Populacao[]
  populacoesEstimadas       PopulacaoEstimada[]
  indicadoresMunicipais     IndicadorMunicipal[]
  qualidadeChecks           QualidadeCheck[]
  fatosInternacaoResidenciaRegional FatoInternacaoResidenciaRegional[]
  fatosInternacaoLocalRegional      FatoInternacaoLocalRegional[]
  fatosCapacidadeLeitosRegional     FatoCapacidadeLeitosRegional[]

  @@index([fonteDadosId, competenciaId])
  @@index([status])
  @@schema("meta")
}

model QualidadeCheck {
  id                 String   @id @default(cuid())
  ingestaoExecucaoId String
  ingestaoExecucao   IngestaoExecucao @relation(fields: [ingestaoExecucaoId], references: [id])
  regra              String
  severidade         SeveridadeCheck
  passou             Boolean
  linhasAfetadas     Int?
  detalhe            String?
  createdAt          DateTime @default(now())

  @@index([ingestaoExecucaoId])
  @@schema("meta")
}

/// Criada nesta fase, NAO usada ainda - nenhum middleware da API escreve
/// aqui. Trilha de auditoria de consulta/exportacao e entrega da Fase 6.
model AuditLog {
  id               String   @id @default(cuid())
  usuarioId        String?
  usuario          Usuario? @relation(fields: [usuarioId], references: [id])
  acao             String
  recurso          String
  filtrosAplicados Json?
  ip               String?
  userAgent        String?
  criadoEm         DateTime @default(now())

  @@index([usuarioId, criadoEm])
  @@index([acao])
  @@schema("meta")
}

/// RBAC inerte ate a Fase 6 (roadmap.md). Estrutura minima apenas.
model Usuario {
  id       String   @id @default(cuid())
  email    String   @unique
  nome     String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  perfis    PerfilAtribuicao[]
  auditLogs AuditLog[]

  @@schema("meta")
}

model PerfilAtribuicao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  perfil    Perfil
  criadoEm  DateTime @default(now())

  escopos EscopoTerritorial[]

  @@unique([usuarioId, perfil])
  @@schema("meta")
}

model EscopoTerritorial {
  id                 String   @id @default(cuid())
  perfilAtribuicaoId String
  perfilAtribuicao   PerfilAtribuicao @relation(fields: [perfilAtribuicaoId], references: [id])
  nivel              NivelEscopo
  municipioId        Int?
  municipio          Municipio? @relation(fields: [municipioId], references: [id])
  regiaoSaudeId      Int?
  regiaoSaude        RegiaoSaude? @relation(fields: [regiaoSaudeId], references: [id])

  @@index([perfilAtribuicaoId])
  @@schema("meta")
}

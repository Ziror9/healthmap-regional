{
  "name": "@healthmap/db",
  "version": "0.0.0",
  "private": true,
  "description": "Camada de acesso a dados: Prisma, conexao PostgreSQL e repositorios",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "check": "tsx src/scripts/check-connection.ts",
    "snapshot:create": "tsx src/scripts/snapshot.ts create",
    "snapshot:restore": "tsx src/scripts/snapshot.ts restore",
    "snapshot:verify": "tsx src/scripts/snapshot.ts verify",
    "seed": "tsx src/scripts/seed-demo.ts",
    "calculate-risk": "tsx src/scripts/calculate-risk-demo.ts",
    "calculate-indicadores-real": "tsx src/scripts/calculate-indicadores-real.ts",
    "calculate-indicadores-mortalidade-real": "tsx src/scripts/calculate-indicadores-mortalidade-real.ts",
    "calculate-risk-real": "tsx src/scripts/calculate-risk-real.ts",
    "calculate-risk-regional": "tsx src/scripts/calculate-risk-regional.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@healthmap/risk": "*",
    "@prisma/client": "^6.2.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "prisma": "^6.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.4"
  }
}
